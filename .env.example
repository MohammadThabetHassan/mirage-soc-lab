# MIRAGE SOC Lab public configuration template
# Copy this file to .env for local development. Never commit populated secrets.

# Runtime
NODE_ENV=development
PORT=3000

# Required for production startup validation
VITE_APP_ID=your-oauth-application-id
JWT_SECRET=replace-with-a-unique-32-character-or-longer-secret
DATABASE_URL=mysql://username:password@127.0.0.1:3306/mirage
OAUTH_SERVER_URL=https://your-oauth-provider.example
VITE_OAUTH_PORTAL_URL=https://your-oauth-provider.example
OWNER_OPEN_ID=your-initial-administrator-open-id

# Optional privacy-preserving analytics. Leave both values empty to disable.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Optional map-provider values. Leave empty when map functionality is unused.
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# Platform-provided service values. Do not set these for a normal self-hosted deployment.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
